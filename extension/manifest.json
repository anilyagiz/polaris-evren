{
  "manifest_version": 3,
  "name": "Polaris · EVREN Asistan",
  "description": "Sesli, açıklanabilir kişisel asistan yan paneli.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "side_panel": { "default_path": "src/panel/index.html" },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Polaris panelini aç" }
}
