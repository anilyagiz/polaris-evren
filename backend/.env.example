# backend/.env — Kişi 3 sahiptir.
# Kopyala ve doldur:  copy .env.example .env
#
# !! K3 ONAYI GEREKİYOR !!
# Aşağıdaki LLM değerleri (DEEPSEEK_BASE_URL, LLM_MODEL) Kişi 5 tarafından bu
# demo makinesinin ortamına göre dolduruldu. ORTAK BAĞLAM §4'te bu iki satır
# DEEPSEEK_BASE_URL=https://api.deepseek.com ve LLM_MODEL= (boş) olarak
# donmuştur. K3 doğrulayıp kendi sürümünü yazmalıdır — bkz. docs/HANDOFF-K3.md

# --- LLM (EVREN, OpenAI uyumlu DeepSeek) ---
DEEPSEEK_API_KEY=evren_llm_...
# openai SDK'ya base_url olarak olduğu gibi verilir; /v1 zaten burada.
DEEPSEEK_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_MODEL=deepseek-v4.1-flash

# --- Arama (Kişi 5: web.search) ---
BRAVE_API_KEY=

# --- Ses (Kişi 5) ---
# small: sözleşmeli varsayılan (~2.9 sn/5 sn ses, int8). base: ~3x hızlı ama
# Türkçe doğruluğu daha düşük. Yavaş kalırsa base'e düşülebilir.
STT_MODEL=small                 # small | base
STT_CPU_THREADS=8               # boş bırakılırsa mantıksal çekirdek/2 kullanılır
TTS_VOICE=tr-TR-EmelNeural

# --- Genel ---
TIMEZONE=Europe/Istanbul
# ASSISTANT_DB=                 # (isteğe bağlı) testler için ayrı veritabanı yolu

# --- Masaüstü (Kişi 4 / CUA) ---
CUA_ENABLED=false
DESKTOP_PARSER=ocr              # ocr | omniparser
