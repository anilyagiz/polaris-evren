# backend/.env — Kişi 3 sahiptir; Kişi 5 iskeleti oluşturdu, K3 doğrulayacak.
# Kopyala ve doldur:  cp .env.example .env

# --- LLM (EVREN, OpenAI uyumlu DeepSeek) ---
DEEPSEEK_API_KEY=evren_llm_...
# openai SDK'ya base_url olarak olduğu gibi verilir; sonuna /v1 EKLEME.
DEEPSEEK_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_MODEL=deepseek-v4.1-flash

# --- Arama (Kişi 5: web.search) ---
BRAVE_API_KEY=

# --- Ses (Kişi 5) ---
# small: sözleşmeli varsayılan (~2.9 sn/5 sn ses). Demo için base önerilir (~0.9 sn).
STT_MODEL=small                 # small | base
TTS_VOICE=tr-TR-EmelNeural

# --- Genel ---
TIMEZONE=Europe/Istanbul

# --- Masaüstü (Kişi 4 / CUA) ---
CUA_ENABLED=false
DESKTOP_PARSER=ocr              # ocr | omniparser
