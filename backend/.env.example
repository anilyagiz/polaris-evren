# Kurulum:  copy backend\.env.example backend\.env   sonra değerleri doldur.
# backend/.env git'e girmez (.gitignore). Buraya gerçek anahtar yazma.

# --- LLM (DeepSeek, OpenAI uyumlu) ---
DEEPSEEK_API_KEY=buraya_anahtarini_yaz
# Doğrudan DeepSeek için bu değerler; farklı bir OpenAI uyumlu ağ geçidi
# kullanıyorsan base URL'i (örn. https://ornek-gateway.example/v1) ve model adını değiştir.
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Arama (web.search) ---
# Brave Search API anahtarı (boşsa web.search hata döner)
# Boş bırakılırsa web araması anahtarsız DuckDuckGo yedeğiyle yapılır (WEB_SEARCH_FALLBACK=off ile kapatılır).
BRAVE_API_KEY=

# --- Ses ---
STT_MODEL=small                 # small | base (base daha hızlı, Türkçede daha zayıf)
# STT_CPU_THREADS=8             # boşsa mantıksal çekirdek / 2
TTS_VOICE=tr-TR-EmelNeural

# --- Genel ---
TIMEZONE=Europe/Istanbul
# ASSISTANT_DB=                 # isteğe bağlı: test için ayrı veritabanı yolu

# --- Masaüstü (CUA) — isteğe bağlı, Docker gerekir ---
CUA_ENABLED=false
DESKTOP_PARSER=ocr              # ocr | omniparser

# --- Orkestratör (isteğe bağlı; varsayılanlar backend/config.py içinde) ---
# LLM_TIMEOUT_S=30
# TOOL_TIMEOUT_S=20
# CONFIRM_TIMEOUT_S=60
# MAX_TOOL_CALLS=8
# REQUEST_BUDGET_S=90
# MAX_REVISIONS=2
# REMINDER_POLL_S=30
# HOST=0.0.0.0
# PORT=8765

# --- Model seçimi (EVREN ağ geçidi örneği) ---
# LLM_MODEL=gemma-4-31b
# Birincil model hata verirse (zaman aşımı, 5xx, model yok) bu modele düşülür.
# LLM_FALLBACK_MODEL=deepseek-v4.1-flash
# off: birincil modelin gizli 'düşünme' adımını kapatır (Gemma'da adım ~1 sn).
# LLM_THINKING=off
