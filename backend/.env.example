# backend/.env — owned by Person 3 (K3).
# Copy and fill in:  copy .env.example .env
#
# K3 SIGN-OFF (docs/HANDOFF-K3.md §2): APPROVED as written below.
# The demo machine talks to the EVREN OpenAI-compatible gateway, not to
# api.deepseek.com directly, so these two values are the ones that actually
# work here. This file contains no secret; the real DEEPSEEK_API_KEY lives only
# in the git-ignored backend/.env. To point at DeepSeek directly instead:
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat

# --- LLM (EVREN, OpenAI-compatible DeepSeek) ---
DEEPSEEK_API_KEY=evren_llm_...
# Passed to the openai SDK as base_url; the /v1 suffix is already here.
DEEPSEEK_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_MODEL=deepseek-v4.1-flash

# --- Search (Person 5: web.search) ---
BRAVE_API_KEY=

# --- Voice (Person 5) ---
# small: contractual default (~2.1s per 5s clip, int8). base: ~2x faster but
# less accurate in Turkish. Drop to base only if small is too slow.
STT_MODEL=small                 # small | base
STT_CPU_THREADS=8               # blank -> logical cores / 2 (never give all logical cores)
TTS_VOICE=tr-TR-EmelNeural

# --- General ---
TIMEZONE=Europe/Istanbul
# ASSISTANT_DB=                 # optional: separate database path for tests

# --- Desktop (Person 4 / CUA) ---
CUA_ENABLED=false
DESKTOP_PARSER=ocr              # ocr | omniparser

# --- Orchestrator (Person 3 / K3), optional — defaults live in backend/config.py ---
# LLM_TIMEOUT_S=30              # single LLM call timeout
# TOOL_TIMEOUT_S=20             # extension tool_result budget (contract: 20 s)
# CONFIRM_TIMEOUT_S=60          # need_confirm budget (contract: 60 s, silence = rejected)
# MAX_TOOL_CALLS=8              # tool calls per request
# REQUEST_BUDGET_S=90           # total wall clock per request
# MAX_REVISIONS=2               # judge "revise" rounds
# REMINDER_POLL_S=30            # reminders.due() polling interval
# HOST=0.0.0.0
# PORT=8000
