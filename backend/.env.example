# backend/.env — owned by Person 3 (K3).
# Copy and fill in:  copy .env.example .env
#
# !! NEEDS K3 SIGN-OFF !!
# The LLM values below (DEEPSEEK_BASE_URL, LLM_MODEL) were filled in by Person 5
# to match this demo machine. ORTAK BAĞLAM §4 freezes these two lines as
# DEEPSEEK_BASE_URL=https://api.deepseek.com and LLM_MODEL= (empty). K3 should
# confirm and write its own version — see docs/HANDOFF-K3.md

# --- LLM (EVREN, OpenAI-compatible DeepSeek) ---
DEEPSEEK_API_KEY=evren_llm_...
# Passed to the openai SDK as base_url; the /v1 suffix is already here.
DEEPSEEK_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
LLM_MODEL=deepseek-v4.1-flash

# --- Search (Person 5: web.search) ---
BRAVE_API_KEY=

# --- Voice (Person 5) ---
# small: contractual default (~2.1s per 5s clip, int8). base: ~2x faster but
# less accurate in Turkish. Drop to base only if small is too slow.
STT_MODEL=small                 # small | base
STT_CPU_THREADS=8               # blank -> logical cores / 2 (never give all logical cores)
TTS_VOICE=tr-TR-EmelNeural

# --- General ---
TIMEZONE=Europe/Istanbul
# ASSISTANT_DB=                 # optional: separate database path for tests

# --- Desktop (Person 4 / CUA) ---
CUA_ENABLED=false
DESKTOP_PARSER=ocr              # ocr | omniparser
